#!/bin/sh
# UltraDisplay AppImage entry point.
#   UltraDisplay-x86_64.AppImage [--hidden]       the app (window + tray)
#   UltraDisplay-x86_64.AppImage headless [...]   the daemon without GUI
HERE="$(dirname "$(readlink -f "$0")")"
if [ "${1:-}" = headless ]; then
    shift
    exec "$HERE/usr/bin/ultradisplayd" "$@"
fi
exec "$HERE/usr/bin/ultradisplay" "$@"
